// BSLLS:DuplicatedInsertionIntoCollection-off
// BSLLS:CognitiveComplexity-off
// BSLLS:LineLength-off
// BSLLS:DuplicateStringLiteral-off

#Использовать asserts
#Использовать tempfiles
#Использовать ".."

Перем МенеджерВременныхФайлов; // МенеджерВременныхФайлов
Перем Потоки; // Массив

Процедура ПередЗапускомТестов() Экспорт

	МенеджерВременныхФайлов = Новый МенеджерВременныхФайлов();
	Потоки = Новый Массив();

КонецПроцедуры

&После
Процедура ПослеЗапускаТеста() Экспорт

	ЗакрытьПотоки();
	МенеджерВременныхФайлов.Удалить();

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпаковыватьИРаспаковыватьТекстовыеИБинарныеДанные() Экспорт

	Для Каждого ИсходныеДанные Из НаборыТестовыхДанных() Цикл
		Для Каждого Компрессор Из Компрессоры() Цикл

			УпакованныеДанные = Компрессор.Упаковать(ИсходныеДанные);
			РаспакованныеДанные = Компрессор.Распаковать(УпакованныеДанные);

			Ожидаем.Что(РаспакованныеДанные, СтрШаблон("%1, размер %2", Компрессор, ИсходныеДанные.Размер())).Равно(ИсходныеДанные);

		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпаковыватьИРаспаковыватьПустыеДанныеSnappy() Экспорт

	ПустыеДанные = ПолучитьДвоичныеДанныеИзСтроки("");
	Компрессор = Новый SnappyКомпрессор();

	УпакованныеДанные = Компрессор.Упаковать(ПустыеДанные);
	РаспакованныеДанные = Компрессор.Распаковать(УпакованныеДанные);

	Ожидаем.Что(РаспакованныеДанные, Компрессор).Равно(ПустыеДанные);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонятьПустыеДанныеПриУпаковкеКомпрессорамиКромеSnappy() Экспорт

	ПустыеДанные = ПолучитьДвоичныеДанныеИзСтроки("");

	Для Каждого Компрессор Из КомпрессорыБезПоддержкиПустогоБуфера() Цикл

		ПараметрыМетода = Новый Массив();
		ПараметрыМетода.Добавить(ПустыеДанные);

		Ожидаем.Что(Компрессор, Компрессор)
			.Метод("Упаковать", ПараметрыМетода)
			.ВыбрасываетИсключение();

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонятьПустыеДанныеПриРаспаковкеКомпрессорамиКромеSnappy() Экспорт

	ПустыеДанные = ПолучитьДвоичныеДанныеИзСтроки("");

	Для Каждого Компрессор Из КомпрессорыБезПоддержкиПустогоБуфера() Цикл
		ПроверитьНеРаспаковывает(Компрессор, ПустыеДанные);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписыватьУпакованныеИРаспакованныеДанныеВПотокВПамяти() Экспорт

	Компрессоры = Компрессоры();
	ИсходныеДанные = ТестовыеДвоичныеДанные();

	Для Каждого Компрессор Из Компрессоры Цикл

		ИсходящийПоток = Новый ПотокВПамяти();
		Компрессор.Упаковать(ИсходныеДанные, ИсходящийПоток);
		УпакованныеДанные = ДвоичныеДанныеИзПотока(ИсходящийПоток);

		ИсходящийПоток = Новый ПотокВПамяти();
		Компрессор.Распаковать(УпакованныеДанные, ИсходящийПоток);
		РаспакованныеДанные = ДвоичныеДанныеИзПотока(ИсходящийПоток);

		ПроверитьРаспакованныеДанные(Компрессор, РаспакованныеДанные, ИсходныеДанные);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_РаспаковыватьУпакованныйПотокВПамятиВДвоичныеДанные() Экспорт

	Компрессоры = Компрессоры();
	ИсходныеДанные = ТестовыеДвоичныеДанные();

	Для Каждого Компрессор Из Компрессоры Цикл

		УпакованныеДанные = Компрессор.Упаковать(ИсходныеДанные);

		Поток = ПотокИзДвоичныхДанных(УпакованныеДанные);
		РаспакованныеДанные = Компрессор.Распаковать(Поток);
		
		ПроверитьРаспакованныеДанные(Компрессор, РаспакованныеДанные, ИсходныеДанные);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпаковыватьИРаспаковыватьПотокВПамятиВДвоичныеДанные() Экспорт

	Компрессоры = Компрессоры();
	ИсходныеДанные = ТестовыеДвоичныеДанные();
		
	Для Каждого Компрессор Из Компрессоры Цикл

		Поток = ПотокИзДвоичныхДанных(ИсходныеДанные);
		УпакованныеДанные = Компрессор.Упаковать(Поток);

		Поток = ПотокИзДвоичныхДанных(УпакованныеДанные);
		РаспакованныеДанные = Компрессор.Распаковать(Поток);

		ПроверитьРаспакованныеДанные(Компрессор, РаспакованныеДанные, ИсходныеДанные);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпаковыватьИРаспаковыватьПотокВПамятиВПотокВПамяти() Экспорт

	Компрессоры = Компрессоры();
	ИсходныеДанные = ТестовыеДвоичныеДанные();
	
	Для Каждого Компрессор Из Компрессоры Цикл

		ВходящийПоток = ПотокИзДвоичныхДанных(ИсходныеДанные);
		ИсходящийПоток = Новый ПотокВПамяти();
		Компрессор.Упаковать(ВходящийПоток, ИсходящийПоток);

		ВходящийПоток = ПотокИзДвоичныхДанных(ДвоичныеДанныеИзПотока(ИсходящийПоток));
		ИсходящийПоток = Новый ПотокВПамяти();
		Компрессор.Распаковать(ВходящийПоток, ИсходящийПоток);
		РаспакованныеДанные = ДвоичныеДанныеИзПотока(ИсходящийПоток);

		ПроверитьРаспакованныеДанные(Компрессор, РаспакованныеДанные, ИсходныеДанные);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпаковыватьИРаспаковыватьФайловыйПотокВДвоичныеДанные() Экспорт

	Компрессоры = Компрессоры();

	ПутьКФайлу = МенеджерВременныхФайлов.НовоеИмяФайла();
	ИсходныеДанные = ТестовыеДвоичныеДанные();
	ИсходныеДанные.Записать(ПутьКФайлу);

	ИсходныйФайловыйПоток = Новый ФайловыйПоток(ПутьКФайлу, РежимОткрытияФайла.Открыть);
	Потоки.Добавить(ИсходныйФайловыйПоток);

	Для Каждого Компрессор Из Компрессоры Цикл

		ИсходныйФайловыйПоток.Перейти(0, ПозицияВПотоке.Начало);
		ПутьКУпакованномуФайлу = МенеджерВременныхФайлов.НовоеИмяФайла();

		УпакованныеДанные = Компрессор.Упаковать(ИсходныйФайловыйПоток);
		УпакованныеДанные.Записать(ПутьКУпакованномуФайлу);

		УпакованныйПоток = Новый ФайловыйПоток(ПутьКУпакованномуФайлу, РежимОткрытияФайла.Открыть);
		Потоки.Добавить(УпакованныйПоток);

		РаспакованныеДанные = Компрессор.Распаковать(УпакованныйПоток);

		Ожидаем.Что(РаспакованныеДанные, Компрессор).Равно(ИсходныеДанные);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписыватьУпакованныеИРаспакованныеДанныеВФайловыеПотоки() Экспорт

	ИсходныеДанные = ТестовыеДвоичныеДанные();

	Для Каждого Компрессор Из Компрессоры() Цикл

		ПутьКУпакованномуФайлу = МенеджерВременныхФайлов.НовоеИмяФайла();
		ПотокУпакованныхДанных = Новый ФайловыйПоток(ПутьКУпакованномуФайлу, РежимОткрытияФайла.Создать);
		Потоки.Добавить(ПотокУпакованныхДанных);

		Компрессор.Упаковать(ИсходныеДанные, ПотокУпакованныхДанных);
		ПотокУпакованныхДанных.Закрыть();

		ПотокУпакованныхДанных = Новый ФайловыйПоток(ПутьКУпакованномуФайлу, РежимОткрытияФайла.Открыть);
		Потоки.Добавить(ПотокУпакованныхДанных);

		ПутьКРаспакованномуФайлу = МенеджерВременныхФайлов.НовоеИмяФайла();
		ПотокРаспакованныхДанных = Новый ФайловыйПоток(ПутьКРаспакованномуФайлу, РежимОткрытияФайла.Создать);
		Потоки.Добавить(ПотокРаспакованныхДанных);

		Компрессор.Распаковать(ПотокУпакованныхДанных, ПотокРаспакованныхДанных);
		ПотокУпакованныхДанных.Закрыть();
		ПотокРаспакованныхДанных.Закрыть();

		РаспакованныеДанные = Новый ДвоичныеДанные(ПутьКРаспакованномуФайлу);

		Ожидаем.Что(РаспакованныеДанные, Компрессор).Равно(ИсходныеДанные);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпаковыватьПотокНачинаяСТекущейПозиции() Экспорт

	Префикс = "skip:";
	ПолныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Префикс + "payload");
	ОжидаемыеДанные = ПолучитьДвоичныеДанныеИзСтроки("payload");

	Для Каждого Компрессор Из Компрессоры() Цикл

		Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ПолныеДанные);
		Поток = Новый ПотокВПамяти(Буфер);
		Поток.Перейти(СтрДлина(Префикс), ПозицияВПотоке.Начало);

		УпакованныеДанные = Компрессор.Упаковать(Поток);
		РаспакованныеДанные = Компрессор.Распаковать(УпакованныеДанные);

		Ожидаем.Что(РаспакованныеДанные, Компрессор).Равно(ОжидаемыеДанные);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпаковыватьИРаспаковыватьСКаждымПоддерживаемымУровнемСжатия() Экспорт

	ИсходныеДанные = ТестовыеДвоичныеДанные();

	Для Каждого Компрессор Из КомпрессорыСУровнямиСжатия() Цикл
		УпакованныеДанные = Компрессор.Упаковать(ИсходныеДанные);
		РаспакованныеДанные = Компрессор.Распаковать(УпакованныеДанные);

		ПроверитьРаспакованныеДанные(Компрессор, РаспакованныеДанные, ИсходныеДанные);
	КонецЦикла;

КонецПроцедуры

&Тест
&Параметры("GZip")
&Параметры("Deflate")
&Параметры("LZ4")
&Параметры("ZLib")
&Параметры("Zstd")
Процедура ТестДолжен_ОтклонятьНекорректныйУровеньСжатияВКонструкторе(ИмяАлгоритма) Экспорт

	ОшибочныйУровньСжатия = Новый Массив();

	ПроверитьКонструкторВыбрасываетИсключение(ИмяАлгоритма, ОшибочныйУровньСжатия);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонятьАргументыНедопустимыхТипов() Экспорт

	ДвоичныеДанные = ТестовыеДвоичныеДанные();
	ОшибочноеЗначение = Новый Массив();

	ТестовыеСлучаи = Новый ТаблицаЗначений();
	ТестовыеСлучаи.Колонки.Добавить("Метод");
	ТестовыеСлучаи.Колонки.Добавить("Данные");
	ТестовыеСлучаи.Колонки.Добавить("Поток");
	ТестовыеСлучаи.Колонки.Добавить("Сообщение");

	ТестовыйСлучай = ТестовыеСлучаи.Добавить();
	ТестовыйСлучай.Метод = "Упаковать";
	ТестовыйСлучай.Данные = ОшибочноеЗначение;
	ТестовыйСлучай.Сообщение = "Неверный тип аргумента 'data'";

	ТестовыйСлучай = ТестовыеСлучаи.Добавить();
	ТестовыйСлучай.Метод = "Упаковать";
	ТестовыйСлучай.Данные = ОшибочноеЗначение;
	ТестовыйСлучай.Поток = ОшибочноеЗначение;
	ТестовыйСлучай.Сообщение = "Неверный тип аргумента 'data'";

	ТестовыйСлучай = ТестовыеСлучаи.Добавить();
	ТестовыйСлучай.Метод = "Упаковать";
	ТестовыйСлучай.Данные = ДвоичныеДанные;
	ТестовыйСлучай.Поток = ОшибочноеЗначение;
	ТестовыйСлучай.Сообщение = "Неверный тип аргумента 'outputStream'";

	ТестовыйСлучай = ТестовыеСлучаи.Добавить();
	ТестовыйСлучай.Метод = "Распаковать";
	ТестовыйСлучай.Данные = ОшибочноеЗначение;
	ТестовыйСлучай.Сообщение = "Неверный тип аргумента 'data'";

	ТестовыйСлучай = ТестовыеСлучаи.Добавить();
	ТестовыйСлучай.Метод = "Распаковать";
	ТестовыйСлучай.Данные = ОшибочноеЗначение;
	ТестовыйСлучай.Поток = ОшибочноеЗначение;
	ТестовыйСлучай.Сообщение = "Неверный тип аргумента 'data'";

	ТестовыйСлучай = ТестовыеСлучаи.Добавить();
	ТестовыйСлучай.Метод = "Распаковать";
	ТестовыйСлучай.Данные = ДвоичныеДанные;
	ТестовыйСлучай.Поток = ОшибочноеЗначение;
	ТестовыйСлучай.Сообщение = "Неверный тип аргумента 'outputStream'";

	Для Каждого Компрессор Из Компрессоры() Цикл
		
		Для Каждого ТестовыйСлучай Из ТестовыеСлучаи Цикл

			ПараметрыМетода = Новый Массив();
			ПараметрыМетода.Добавить(ТестовыйСлучай.Данные);
			ПараметрыМетода.Добавить(ТестовыйСлучай.Поток);

			Ожидаем.Что(Компрессор, СтрШаблон("%1.%2: %3", Компрессор, ТестовыйСлучай.Метод, ТестовыйСлучай.Сообщение))
				.Метод(ТестовыйСлучай.Метод, ПараметрыМетода)
				.ВыбрасываетИсключение(ТестовыйСлучай.Сообщение);

		КонецЦикла;

	КонецЦикла;
	
КонецПроцедуры

&Тест
&Параметры("GZip", "31,139")
&Параметры("ZLib", "120")
&Параметры("LZ4", "4,34,77,24")
&Параметры("Snappy", "255,6,0,0,115,78,97,80,112,89")
&Параметры("Zstd", "40,181,47,253")
Процедура ТестДолжен_ЗаписыватьМагическуюСигнатуруФормата(ИмяАлгоритма, ОжидаемыеБайты) Экспорт

	ИсходныеДанные = ТестовыеДвоичныеДанные();
	Компрессор = СоздатьКомпрессорПоИмени(ИмяАлгоритма);

	ПроверитьПервыеБайты(Компрессор.Упаковать(ИсходныеДанные), МассивБайтов(ОжидаемыеБайты), ИмяАлгоритма);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонятьЗаведомоНекорректныеДанныеПриРаспаковке() Экспорт

	ПоврежденныеДанные = ПолучитьДвоичныеДанныеИзСтроки("not compressed data");

	Для Каждого Компрессор Из Компрессоры() Цикл

		ПараметрыМетода = Новый Массив();
		ПараметрыМетода.Добавить(ПоврежденныеДанные);

		Ожидаем.Что(Компрессор, Компрессор)
			.Метод("Распаковать", ПараметрыМетода)
			.ВыбрасываетИсключение();

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеВозвращатьИсходныеДанныеПриПоврежденииАрхива() Экспорт

	ИсходныеДанные = ТестовыеДвоичныеДанные();

	Для Каждого Компрессор Из Компрессоры() Цикл

		УпакованныеДанные = Компрессор.Упаковать(ИсходныеДанные);
		ПоврежденныеДанные = ИспортитьДвоичныеДанные(УпакованныеДанные);

		ПроверитьНеРаспаковываетВИсходные(Компрессор, ПоврежденныеДанные, ИсходныеДанные);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонятьДанныеСжатыеДругимАлгоритмом() Экспорт

	ИсходныеДанные = ТестовыеДвоичныеДанные();

	УпакованныеGZip = Новый GZipКомпрессор().Упаковать(ИсходныеДанные);
	ПроверитьНеРаспаковывает(Новый DeflateКомпрессор(), УпакованныеGZip);
	ПроверитьНеРаспаковывает(Новый ZLibКомпрессор(), УпакованныеGZip);

	УпакованныеZLib = Новый ZLibКомпрессор().Упаковать(ИсходныеДанные);
	ПроверитьНеРаспаковывает(Новый GZipКомпрессор(), УпакованныеZLib);

КонецПроцедуры

&Тест
&Параметры("Упаковать", "Поток", "Поток")
&Параметры("Упаковать", "ДД", "Поток")
&Параметры("Упаковать", "Поток", "ДД")
&Параметры("Распаковать", "Поток", "Поток")
&Параметры("Распаковать", "ДД", "Поток")
&Параметры("Распаковать", "Поток", "ДД")
Процедура ТестДолжен_ОставлятьПотокиОткрытымиПослеУпаковкиИРаспаковки(Метод, ТипВхода, ТипВыхода) Экспорт

	Компрессоры = Компрессоры();
	ТестовыеДанные = ТестовыеДвоичныеДанные();

	Для Каждого Компрессор Из Компрессоры Цикл

		Если Метод = "Упаковать" Тогда
			ИсходныеДанные = ТестовыеДанные;
		Иначе
			ИсходныеДанные = Компрессор.Упаковать(ТестовыеДанные);
		КонецЕсли;

		Если ТипВхода = "Поток" Тогда
			Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ИсходныеДанные);
			ВходящиеДанные = Новый ПотокВПамяти(Буфер);
		Иначе
			ВходящиеДанные = ИсходныеДанные;
		КонецЕсли;

		Если ТипВыхода = "Поток" Тогда
			ИсходящиеДанные = Новый ПотокВПамяти();
		Иначе
			ИсходящиеДанные = Неопределено;
		КонецЕсли;

		Если Метод = "Упаковать" Тогда
			Компрессор.Упаковать(ВходящиеДанные, ИсходящиеДанные);
		Иначе
			Компрессор.Распаковать(ВходящиеДанные, ИсходящиеДанные);
		КонецЕсли;

		Сообщение = СтрШаблон("%1.%2(%3, %4)", Компрессор, Метод, ТипВхода, ТипВыхода);

		ПроверитьСостояниеПотока(ВходящиеДанные, Сообщение);
		ПроверитьСостояниеПотока(ИсходящиеДанные, Сообщение);

	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьСостояниеПотока(Поток, Сообщение)

	Если ТипЗнч(Поток) <> Тип("ПотокВПамяти") Тогда
		Возврат;
	КонецЕсли;

	Ожидаем.Что(Поток.ДоступноЧтение, "Доступно чтение потока. " + Сообщение).ЭтоИстина();
	Ожидаем.Что(Поток.ДоступнаЗапись, "Доступна запись в поток. " + Сообщение).ЭтоИстина();
	Ожидаем.Что(Поток.ТекущаяПозиция(), "Текущая позиция потока. " + Сообщение).Равно(Поток.Размер());

	Поток.Перейти(0, ПозицияВПотоке.Начало);

	Буфер = Новый БуферДвоичныхДанных(1);
	Поток.Записать(Буфер, 0, Буфер.Размер);

КонецПроцедуры

Процедура ЗакрытьПотоки()

	Для Каждого Поток Из Потоки Цикл
		Попытка
			Поток.Закрыть();
		Исключение
		КонецПопытки;
	КонецЦикла;

	Потоки = Новый Массив();

КонецПроцедуры

Функция НаборыТестовыхДанных()

	Наборы = Новый Массив();
	Наборы.Добавить(ТестовыеДвоичныеДанные());
	Наборы.Добавить(ПолучитьДвоичныеДанныеИзСтроки("x"));
	Наборы.Добавить(ПолучитьДвоичныеДанныеИзСтроки("0123456789abcdef"));
	Наборы.Добавить(ПолучитьДвоичныеДанныеИзСтроки("0123456789abcdef!"));
	Наборы.Добавить(ПолучитьДвоичныеДанныеИзСтроки(ПовторитьСтроку("0123456789abcdef", 256)));
	Наборы.Добавить(БинарныеТестовыеДанные());

	Возврат Наборы;

КонецФункции

Функция ПотокИзДвоичныхДанных(ДвоичныеДанные)

	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДвоичныеДанные);

	Возврат Новый ПотокВПамяти(Буфер);

КонецФункции

Функция ДвоичныеДанныеИзПотока(Поток)

	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();

КонецФункции

Процедура ПроверитьРаспакованныеДанные(Компрессор, РаспакованныеДанные, ИсходныеДанные)

	Ожидаем.Что(РаспакованныеДанные, Компрессор).Равно(ИсходныеДанные);

КонецПроцедуры

Процедура ПроверитьКонструкторВыбрасываетИсключение(ИмяАлгоритма, Параметр)

	БылоИсключение = Ложь;

	Попытка
		Выполнить("Компрессор = Новый " + ИмяАлгоритма + "Компрессор(Параметр)");
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;

	Ожидаем.Что(БылоИсключение, ИмяАлгоритма).ЭтоИстина();

КонецПроцедуры

Процедура ПроверитьПервыеБайты(ДвоичныеДанные, ОжидаемыеБайты, Сообщение)

	Ожидаем.Что(ДвоичныеДанные.Размер(), Сообщение).БольшеИлиРавно(ОжидаемыеБайты.Количество());

	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДвоичныеДанные);

	Для Индекс = 0 По ОжидаемыеБайты.Количество() - 1 Цикл
		Ожидаем.Что(Буфер[Индекс], СтрШаблон("%1, байт %2", Сообщение, Индекс)).Равно(ОжидаемыеБайты[Индекс]);
	КонецЦикла;

КонецПроцедуры

Функция МассивБайтов(СтрокаБайтов)

	Результат = Новый Массив();
	Части = СтрРазделить(СтрокаБайтов, ",", Ложь);

	Для Каждого Часть Из Части Цикл
		Результат.Добавить(Число(СокрЛП(Часть)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СоздатьКомпрессорПоИмени(ИмяАлгоритма)

	Если ИмяАлгоритма = "GZip" Тогда
		Возврат Новый GZipКомпрессор();
	ИначеЕсли ИмяАлгоритма = "Deflate" Тогда
		Возврат Новый DeflateКомпрессор();
	ИначеЕсли ИмяАлгоритма = "Brotli" Тогда
		Возврат Новый BrotliКомпрессор();
	ИначеЕсли ИмяАлгоритма = "LZ4" Тогда
		Возврат Новый LZ4Компрессор();
	ИначеЕсли ИмяАлгоритма = "Snappy" Тогда
		Возврат Новый SnappyКомпрессор();
	ИначеЕсли ИмяАлгоритма = "Zstd" Тогда
		Возврат Новый ZstdКомпрессор();
	ИначеЕсли ИмяАлгоритма = "ZLib" Тогда
		Возврат Новый ZLibКомпрессор();
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Неизвестный алгоритм <%1>", ИмяАлгоритма);

КонецФункции

Функция СоздатьКомпрессорыПоИменам(ИменаАлгоритмов)

	Массив = Новый Массив();

	Для Каждого ИмяАлгоритма Из ИменаАлгоритмов Цикл
		Массив.Добавить(СоздатьКомпрессорПоИмени(ИмяАлгоритма));
	КонецЦикла;

	Возврат Массив;

КонецФункции

Функция ИспортитьДвоичныеДанные(ДвоичныеДанные)

	ИсходныйБуфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДвоичныеДанные);
	Результат = Новый БуферДвоичныхДанных(ИсходныйБуфер.Размер);

	Для Индекс = 0 По ИсходныйБуфер.Размер - 1 Цикл
		Результат[Индекс] = ИсходныйБуфер[Индекс];
	КонецЦикла;

	ИндексПовреждения = Цел(ИсходныйБуфер.Размер / 2);
	Результат[ИндексПовреждения] = ?(Результат[ИндексПовреждения] = 0, 1, 0);

	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Результат);

КонецФункции

Процедура ПроверитьНеРаспаковывает(Компрессор, УпакованныеДанные)

	ПараметрыМетода = Новый Массив();
	ПараметрыМетода.Добавить(УпакованныеДанные);

	Ожидаем.Что(Компрессор, Компрессор)
		.Метод("Распаковать", ПараметрыМетода)
		.ВыбрасываетИсключение();

КонецПроцедуры

Процедура ПроверитьНеРаспаковываетВИсходные(Компрессор, УпакованныеДанные, ИсходныеДанные)

	Попытка
		РаспакованныеДанные = Компрессор.Распаковать(УпакованныеДанные);
	Исключение
		Возврат;
	КонецПопытки;

	Ожидаем.Что(РаспакованныеДанные, Компрессор).Не_().Равно(ИсходныеДанные);

КонецПроцедуры

Функция ПовторитьСтроку(Строка, КоличествоПовторов)

	Результат = "";

	Для НомерПовтора = 1 По КоличествоПовторов Цикл
		Результат = Результат + Строка;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция БинарныеТестовыеДанные()

	Буфер = Новый БуферДвоичныхДанных(10);
	Буфер[0] = 0;
	Буфер[1] = 1;
	Буфер[2] = 2;
	Буфер[3] = 31;
	Буфер[4] = 127;
	Буфер[5] = 128;
	Буфер[6] = 254;
	Буфер[7] = 255;
	Буфер[8] = 0;
	Буфер[9] = 65;

	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);

КонецФункции

Функция КомпрессорыСУровнямиСжатия()

	Массив = Новый Массив();

	Массив.Добавить(Новый GZipКомпрессор(УровеньСжатияДанных.Оптимальный));
	Массив.Добавить(Новый GZipКомпрессор(УровеньСжатияДанных.Быстрый));
	Массив.Добавить(Новый GZipКомпрессор(УровеньСжатияДанных.БезСжатия));

	Массив.Добавить(Новый DeflateКомпрессор(УровеньСжатияДанных.Оптимальный));
	Массив.Добавить(Новый DeflateКомпрессор(УровеньСжатияДанных.Быстрый));
	Массив.Добавить(Новый DeflateКомпрессор(УровеньСжатияДанных.БезСжатия));

	Массив.Добавить(Новый LZ4Компрессор(УровеньСжатияДанныхLZ4.L00_FAST));
	Массив.Добавить(Новый LZ4Компрессор(УровеньСжатияДанныхLZ4.L03_HC));
	Массив.Добавить(Новый LZ4Компрессор(УровеньСжатияДанныхLZ4.L04_HC));
	Массив.Добавить(Новый LZ4Компрессор(УровеньСжатияДанныхLZ4.L05_HC));
	Массив.Добавить(Новый LZ4Компрессор(УровеньСжатияДанныхLZ4.L06_HC));
	Массив.Добавить(Новый LZ4Компрессор(УровеньСжатияДанныхLZ4.L07_HC));
	Массив.Добавить(Новый LZ4Компрессор(УровеньСжатияДанныхLZ4.L08_HC));
	Массив.Добавить(Новый LZ4Компрессор(УровеньСжатияДанныхLZ4.L09_HC));
	Массив.Добавить(Новый LZ4Компрессор(УровеньСжатияДанныхLZ4.L10_OPT));
	Массив.Добавить(Новый LZ4Компрессор(УровеньСжатияДанныхLZ4.L11_OPT));
	Массив.Добавить(Новый LZ4Компрессор(УровеньСжатияДанныхLZ4.L12_MAX));

	Массив.Добавить(Новый ZstdКомпрессор(УровеньСжатияДанныхZstd.БезСжатия));
	Массив.Добавить(Новый ZstdКомпрессор(УровеньСжатияДанныхZstd.Быстрый));
	Массив.Добавить(Новый ZstdКомпрессор(УровеньСжатияДанныхZstd.ПоУмолчанию));
	Массив.Добавить(Новый ZstdКомпрессор(УровеньСжатияДанныхZstd.Оптимальный));
	Массив.Добавить(Новый ZstdКомпрессор(УровеньСжатияДанныхZstd.НаименьшийРазмер));

	Массив.Добавить(Новый ZstdКомпрессор(-131072));
	Массив.Добавить(Новый ZstdКомпрессор(-22));
	Массив.Добавить(Новый ZstdКомпрессор(-1));
	Массив.Добавить(Новый ZstdКомпрессор(3));
	Массив.Добавить(Новый ZstdКомпрессор(2));

	Массив.Добавить(Новый ZLibКомпрессор(УровеньСжатияДанных.Оптимальный));
	Массив.Добавить(Новый ZLibКомпрессор(УровеньСжатияДанных.Быстрый));
	Массив.Добавить(Новый ZLibКомпрессор(УровеньСжатияДанных.БезСжатия));

	Возврат Массив;

КонецФункции

Функция Компрессоры()

	Возврат СоздатьКомпрессорыПоИменам(ИменаКомпрессоров());

КонецФункции

Функция ИменаКомпрессоров()

	Массив = Новый Массив();
	Массив.Добавить("GZip");
	Массив.Добавить("Deflate");
	Массив.Добавить("Brotli");
	Массив.Добавить("LZ4");
	Массив.Добавить("Snappy");
	Массив.Добавить("Zstd");
	Массив.Добавить("ZLib");

	Возврат Массив;

КонецФункции

Функция КомпрессорыБезПоддержкиПустогоБуфера()

	Массив = Новый Массив();

	Для Каждого ИмяАлгоритма Из ИменаКомпрессоров() Цикл
		Если ИмяАлгоритма <> "Snappy" Тогда
			Массив.Добавить(СоздатьКомпрессорПоИмени(ИмяАлгоритма));
		КонецЕсли;
	КонецЦикла;

	Возврат Массив;

КонецФункции

Функция ТестовыеДвоичныеДанные()
	Возврат ПолучитьДвоичныеДанныеИзСтроки("https://github.com/Stivo182/oscript-compressor");
КонецФункции
